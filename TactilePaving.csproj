<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{6B1F3C2A-8E4D-4F7A-9C11-2D5E7A3B9F40}</ProjectGuid>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>TactilePaving</RootNamespace>
    <AssemblyName>TactilePaving</AssemblyName>
    <TargetFrameworkVersion>v3.5</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <!-- ゲームのDLLはリポジトリに含めない。別の場所にインストールしている場合は
         msbuild /p:GameManaged=... で指定する -->
    <GameManaged Condition=" '$(GameManaged)' == '' ">C:\Program Files (x86)\Steam\steamapps\common\Cities_Skylines\Cities_Data\Managed\</GameManaged>
    <UUILibDir>$(MSBuildProjectDirectory)\ThirdParty\UnifiedUILib\</UUILibDir>
    <ModDir>$(LOCALAPPDATA)\Colossal Order\Cities_Skylines\Addons\Mods\TactilePaving\</ModDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameManaged)Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ColossalManaged">
      <HintPath>$(GameManaged)ColossalManaged.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ICities">
      <HintPath>$(GameManaged)ICities.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameManaged)UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- UnifiedUILib.dll はモッドと一緒に配布する必要がある -->
    <Reference Include="UnifiedUILib">
      <HintPath>$(UUILibDir)UnifiedUILib.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Core" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="DeferredAction.cs" />
    <Compile Include="LoadingExtension.cs" />
    <Compile Include="Localization.cs" />
    <Compile Include="ModMain.cs" />
    <Compile Include="ModSettings.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
    <Compile Include="SerializableDataExtension.cs" />
    <Compile Include="SettingsPanel.cs" />
    <Compile Include="TactileBlockType.cs" />
    <Compile Include="TactileGeometry.cs" />
    <Compile Include="TactilePavingData.cs" />
    <Compile Include="TactilePavingRenderer.cs" />
    <Compile Include="TactilePavingTool.cs" />
    <Compile Include="TactileTextures.cs" />
    <Compile Include="ToolButton.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- ビルド後にゲームのローカルモッドフォルダへコピーする -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition=" '$(LOCALAPPDATA)' != '' ">
    <MakeDir Directories="$(ModDir)" />
    <Copy SourceFiles="$(TargetPath);$(UUILibDir)UnifiedUILib.dll;$(MSBuildProjectDirectory)\PreviewImage.png" DestinationFolder="$(ModDir)" />
  </Target>
</Project>
